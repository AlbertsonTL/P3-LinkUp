@{ ViewData["Title"] = "Acceso denegado"; Layout = "_Layout"; }
<div class="lu-hero">
    <div class="container text-center text-white">
        <i class="fas fa-lock fa-4x mb-4" style="color:var(--lu-gold)"></i>
        <h1 class="fw-800">Acceso denegado</h1>
        <p class="lead lu-hero-subtitle mx-auto">Debes iniciar sesión para acceder a esta sección.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-gold btn-lg mt-3">
            <i class="fas fa-sign-in-alt me-2"></i>Iniciar sesión
        </a>
    </div>
</div>
