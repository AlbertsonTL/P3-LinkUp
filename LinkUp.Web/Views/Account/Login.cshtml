@model LinkUp.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card card">
        <div class="auth-card-header">
            <div class="brand-logo">
                <img src="/favicon.ico" alt="LinkUp" />
            </div>
            <h2 class="fw-800 mb-1" style="font-size:1.5rem">LinkUp</h2>
            <p class="mb-0" style="opacity:.75;font-size:.88rem">Inicia sesión para continuar</p>
        </div>
        <div class="auth-card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]</div>
            }
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i>@ViewBag.Message</div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                @if (ViewBag.ReturnUrl != null)
                {
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                }
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:var(--lu-gray-100);border-color:var(--lu-gray-300)">
                            <i class="fas fa-user text-navy"></i>
                        </span>
                        <input asp-for="UserName" class="form-control" placeholder="Nombre de usuario" />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:var(--lu-gray-100);border-color:var(--lu-gray-300)">
                            <i class="fas fa-lock text-navy"></i>
                        </span>
                        <input asp-for="Password" class="form-control" placeholder="Tu contraseña" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3" style="padding:.65rem">
                    <i class="fas fa-sign-in-alt me-2"></i>Iniciar sesión
                </button>
            </form>

            <hr style="border-color:var(--lu-gray-300);margin:1.2rem 0">

            <div class="d-grid gap-2">
                <a asp-action="Register" class="btn btn-teal">
                    <i class="fas fa-user-plus me-2"></i>Crear cuenta nueva
                </a>
                <a asp-action="ForgotPassword" class="btn btn-outline-secondary">
                    <i class="fas fa-key me-2"></i>Restablecer contraseña
                </a>
            </div>
        </div>
    </div>
</div>
