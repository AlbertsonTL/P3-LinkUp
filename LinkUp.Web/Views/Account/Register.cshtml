@model LinkUp.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Registro";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card card" style="max-width:640px">
        <div class="auth-card-header">
            <div class="brand-logo">
                <img src="/favicon.ico" alt="LinkUp" />
            </div>
            <h2 class="fw-800 mb-1" style="font-size:1.5rem">Crear cuenta</h2>
            <p class="mb-0" style="opacity:.75;font-size:.88rem">Únete a LinkUp en segundos</p>
        </div>
        <div class="auth-card-body">
            <form asp-action="Register" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control" placeholder="Tu nombre" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <input asp-for="LastName" class="form-control" placeholder="Tu apellido" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" placeholder="809-123-4567" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="correo@ejemplo.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="UserName" class="form-label fw-semibold"></label>
                        <input asp-for="UserName" class="form-control" placeholder="nombreusuario" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Contraseña segura" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite tu contraseña" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="ProfilePicture" class="form-label fw-semibold"></label>
                        <input asp-for="ProfilePicture" class="form-control" type="file" accept="image/*" />
                    </div>
                </div>

                <div class="mt-4 d-grid gap-2">
                    <button type="submit" class="btn btn-primary" style="padding:.65rem">
                        <i class="fas fa-user-plus me-2"></i>Registrarse
                    </button>
                    <a asp-action="Login" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Volver al login
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
