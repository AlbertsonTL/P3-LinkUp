@model LinkUp.Web.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Nueva contraseña"; Layout = "_Layout"; }

<div class="auth-page">
    <div class="auth-card card">
        <div class="auth-card-header">
            <div class="brand-logo">
                <img src="/favicon.ico" alt="LinkUp" />
            </div>
            <h2 class="fw-800 mb-1" style="font-size:1.3rem">Nueva contraseña</h2>
            <p class="mb-0" style="opacity:.75;font-size:.88rem">Elige una contraseña segura</p>
        </div>
        <div class="auth-card-body">
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="Token" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" class="form-control" placeholder="Nueva contraseña" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirma tu contraseña" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100" style="padding:.65rem">
                    <i class="fas fa-save me-2"></i>Guardar contraseña
                </button>
            </form>
        </div>
    </div>
</div>
