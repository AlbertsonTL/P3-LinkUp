@model LinkUp.Web.Models.AttackBoardViewModel
@using LinkUp.Domain.Enums
@{
    ViewData["Title"] = "Tablero de ataque";
    var attackedCells = Model.Board.AttackedCells.ToDictionary(c => $"{c.Row},{c.Col}", c => c.IsHit);
    var isFinished = Model.Board.GameStatus == GameStatus.Finished;
    var isMyTurn = Model.Board.IsMyTurn && !isFinished;
}

@if (isFinished)
{
    <div class="alert alert-info text-center fade-in-up">
        <i class="fas fa-flag-checkered fa-2x mb-2 d-block"></i>
        <strong>¡Esta partida ha terminado!</strong>
        <p class="mb-2">
            @if (Model.Board.WinnerId == Model.Board.UserId)
            {
                <span class="text-success fw-bold">🏆 ¡Ganaste!</span>
            }
            else
            {
                <span class="text-danger fw-bold">💀 Perdiste. Ganó @Model.Board.WinnerUserName.</span>
            }
        </p>
        <a asp-action="GameResult" asp-route-gameId="@Model.GameId" class="btn btn-primary">
            <i class="fas fa-chart-bar me-2"></i>Ver resultado completo
        </a>
    </div>
}
else if (isMyTurn)
{
    <div class="turn-banner your-turn mb-3 fade-in-up">
        <i class="fas fa-crosshairs"></i>
        <span>¡Es tu turno! Haz clic en una celda para atacar.</span>
    </div>
}
else
{
    <div class="turn-banner wait-turn mb-3 fade-in-up">
        <i class="fas fa-hourglass-half"></i>
        <span>Turno de <strong>@Model.Board.CurrentTurnUserName</strong> — esperando su ataque…</span>
    </div>
}

<div class="row justify-content-center">
    <div class="col-auto">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="fw-800 mb-0 text-navy">
                <i class="fas fa-crosshairs me-2 text-gold"></i>Tablero de Ataque
            </h4>
            <div class="d-flex gap-2 flex-wrap">
                @if (!isFinished)
                {
                    <a asp-action="AttackBoard" asp-route-gameId="@Model.GameId" class="btn btn-teal btn-sm">
                        <i class="fas fa-sync me-1"></i>Refrescar
                    </a>
                    <a asp-action="MyBoard" asp-route-gameId="@Model.GameId" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-ship me-1"></i>Ver mis barcos
                    </a>
                    <a asp-action="ConfirmSurrender" asp-route-gameId="@Model.GameId" class="btn btn-danger btn-sm">
                        <i class="fas fa-flag me-1"></i>Rendirse
                    </a>
                }
                else
                {
                    <a asp-action="GameResult" asp-route-gameId="@Model.GameId" class="btn btn-primary btn-sm">
                        <i class="fas fa-chart-bar me-1"></i>Ver resultado
                    </a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Volver
                </a>
            </div>
        </div>

        <div class="d-flex gap-3 mb-3 small">
            <span><span class="badge" style="background:rgba(220,53,69,.2);color:#DC3545;border:1px solid #DC3545">💥 Acertado</span></span>
            <span><span class="badge" style="background:rgba(26,138,74,.15);color:#1A8A4A;border:1px solid #1A8A4A">💧 Fallado</span></span>
            <span><span class="badge bg-light text-muted border">Sin atacar</span></span>
        </div>

        <div class="table-responsive">
            <table class="battleship-board" id="attackTable">
                @for (int row = 0; row < 12; row++)
                {
                    <tr>
                        @for (int col = 0; col < 12; col++)
                        {
                            var key = $"{row},{col}";
                            var wasAttacked = attackedCells.ContainsKey(key);
                            var isHit = wasAttacked && attackedCells[key];

                            string cellClass = "";
                            if (wasAttacked) cellClass = isHit ? "hit" : "miss";

                            string title = wasAttacked
                                ? (isHit ? $"({row+1},{col+1}) ¡Acertado!" : $"({row+1},{col+1}) Fallado")
                                : $"({row+1},{col+1}) Sin atacar";

                            if (wasAttacked || isFinished)
                            {
                                <td class="@cellClass" style="cursor:default" title="@title">
                                    @if (isHit) { <text>💥</text> }
                                    else if (wasAttacked) { <text>💧</text> }
                                </td>
                            }
                            else if (isMyTurn)
                            {
                                <td onclick="submitAttack(@Model.GameId,@row,@col)"
                                    title="@title">·</td>
                            }
                            else
                            {
                                <td style="cursor:default" title="Espera tu turno">·</td>
                            }
                        }
                    </tr>
                }
            </table>
        </div>

        <form id="attackForm" asp-action="Attack" method="post" style="display:none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="gameId" value="@Model.GameId" />
            <input type="hidden" id="attackRow" name="row" />
            <input type="hidden" id="attackCol" name="col" />
        </form>
    </div>
</div>

@section Scripts {
<script>
function submitAttack(gameId, row, col) {
    if (confirm(`¿Atacar la celda (${row+1}, ${col+1})?`)) {
        document.getElementById('attackRow').value = row;
        document.getElementById('attackCol').value = col;
        document.getElementById('attackForm').submit();
    }
}

// Auto-refresh cada 6s cuando NO es mi turno y la partida sigue activa
@if (!isMyTurn && !isFinished)
{
    <text>
    var refreshInterval = setInterval(function() {
        // Recarga el controlador EnterGame que redirige correctamente
        // según el estado actual (rendición, fin de partida, turno)
        window.location.href = '/Battleship/AttackBoard?gameId=@Model.GameId';
    }, 6000);
    </text>
}
</script>
}
