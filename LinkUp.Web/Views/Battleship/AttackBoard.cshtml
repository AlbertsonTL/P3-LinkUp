@model LinkUp.Web.Models.AttackBoardViewModel
@using LinkUp.Domain.Enums
@{
    ViewData["Title"] = "Tablero de ataque";
    var attackedCells = Model.Board.AttackedCells.ToDictionary(c => $"{c.Row},{c.Col}", c => c.IsHit);
    var isFinished = Model.Board.GameStatus == GameStatus.Finished;
    var isMyTurn = Model.Board.IsMyTurn && !isFinished;
}

<div id="battleContent" data-my-turn="@(isMyTurn ? "1" : "0")" data-finished="@(isFinished ? "1" : "0")" data-game-id="@Model.GameId">

@if (isFinished)
{
    <div class="alert alert-info text-center fade-in-up">
        <i class="fas fa-flag-checkered fa-2x mb-2 d-block"></i>
        <strong>¡Esta partida ha terminado!</strong>
        <p class="mb-2">
            @if (Model.Board.WinnerId == Model.Board.UserId)
            {
                <span class="text-success fw-bold">🏆 ¡Ganaste!</span>
            }
            else
            {
                <span class="text-danger fw-bold">💀 Perdiste. Ganó @Model.Board.WinnerUserName.</span>
            }
        </p>
        <a asp-action="GameResult" asp-route-gameId="@Model.GameId" class="btn btn-primary">
            <i class="fas fa-chart-bar me-2"></i>Ver resultado completo
        </a>
    </div>
}
else if (isMyTurn)
{
    <div class="turn-banner your-turn mb-3 fade-in-up">
        <i class="fas fa-crosshairs"></i>
        <span>¡Es tu turno! Haz clic en una celda para atacar.</span>
    </div>
}
else
{
    <div class="turn-banner wait-turn mb-3 fade-in-up">
        <i class="fas fa-hourglass-half"></i>
        <span>Turno de <strong>@Model.Board.CurrentTurnUserName</strong> — esperando su ataque…</span>
    </div>
}

<div class="row justify-content-center">
    <div class="col-auto">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h4 class="fw-800 mb-0 text-navy">
                <i class="fas fa-crosshairs me-2 text-gold"></i>Tablero de Ataque
            </h4>
            <div class="d-flex gap-2 flex-wrap">
                @if (!isFinished)
                {
                    <a asp-action="AttackBoard" asp-route-gameId="@Model.GameId" class="btn btn-teal btn-sm">
                        <i class="fas fa-sync me-1"></i>Refrescar
                    </a>
                    <a asp-action="MyBoard" asp-route-gameId="@Model.GameId" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-ship me-1"></i>Ver mis barcos
                    </a>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#surrenderModal">
                        <i class="fas fa-flag me-1"></i>Rendirse
                    </button>
                }
                else
                {
                    <a asp-action="GameResult" asp-route-gameId="@Model.GameId" class="btn btn-primary btn-sm">
                        <i class="fas fa-chart-bar me-1"></i>Ver resultado
                    </a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left me-1"></i>Volver
                </a>
            </div>
        </div>

        <div class="d-flex gap-3 mb-3 small">
            <span><span class="badge" style="background:rgba(220,53,69,.2);color:#DC3545;border:1px solid #DC3545">💥 Acertado</span></span>
            <span><span class="badge" style="background:rgba(26,138,74,.15);color:#1A8A4A;border:1px solid #1A8A4A">💧 Fallado</span></span>
            <span><span class="badge bg-light text-muted border">Sin atacar</span></span>
        </div>

        <p class="d-md-none text-center text-muted small mb-2"><i class="fas fa-arrows-alt-h me-1"></i>Desliza para ver todo el tablero</p>
        <div class="table-responsive">
            <table class="battleship-board" id="attackTable">
                @for (int row = 0; row < 12; row++)
                {
                    <tr>
                        @for (int col = 0; col < 12; col++)
                        {
                            var key = $"{row},{col}";
                            var wasAttacked = attackedCells.ContainsKey(key);
                            var isHit = wasAttacked && attackedCells[key];

                            string cellClass = "";
                            if (wasAttacked) cellClass = isHit ? "hit" : "miss";

                            string title = wasAttacked
                                ? (isHit ? $"({row+1},{col+1}) ¡Acertado!" : $"({row+1},{col+1}) Fallado")
                                : $"({row+1},{col+1}) Sin atacar";

                            if (wasAttacked || isFinished)
                            {
                                <td class="@cellClass" style="cursor:default" title="@title">
                                    @if (isHit) { <text>💥</text> }
                                    else if (wasAttacked) { <text>💧</text> }
                                </td>
                            }
                            else if (isMyTurn)
                            {
                                <td onclick="submitAttack(@Model.GameId,@row,@col)"
                                    title="@title">·</td>
                            }
                            else
                            {
                                <td style="cursor:default" title="Espera tu turno">·</td>
                            }
                        }
                    </tr>
                }
            </table>
        </div>

        <form id="attackForm" asp-action="Attack" method="post" style="display:none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="gameId" value="@Model.GameId" />
            <input type="hidden" id="attackRow" name="row" />
            <input type="hidden" id="attackCol" name="col" />
        </form>
    </div>
</div>

</div><!-- /#battleContent -->

<div class="modal fade" id="surrenderModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-flag text-danger"></i>¿Rendirte?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-0">Si te rindes, tu oponente será declarado ganador de esta partida.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Surrender" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="gameId" value="@Model.GameId" />
                    <button type="submit" class="btn btn-danger"><i class="fas fa-flag me-2"></i>Sí, rendirme</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="attackConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-crosshairs text-gold"></i>Confirmar ataque</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="confirmAttackText">¿Atacar esta celda?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-gold" onclick="confirmAttack()">
                    <i class="fas fa-crosshairs me-2"></i>Atacar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ---------------------------------------------------------------
// Battleship — interacción sin recarga completa de página.
// IMPORTANTE: no se creó ningún endpoint nuevo. Se usa fetch() contra
// las MISMAS rutas /Battleship/Attack y /Battleship/AttackBoard que ya
// existían, y se reemplaza solo el fragmento #battleContent del HTML
// devuelto. Si fetch falla por cualquier razón, se recurre al mismo
// comportamiento original (submit de formulario / recarga completa),
// así que nunca se pierde funcionalidad.
// ---------------------------------------------------------------

var gameId = @Model.GameId;
var pollInterval = null;

function submitAttack(gameId, row, col) {
    document.getElementById('confirmAttackText').textContent =
        '¿Atacar la celda (' + (row + 1) + ', ' + (col + 1) + ')?';
    document.getElementById('attackRow').value = row;
    document.getElementById('attackCol').value = col;
    var modalEl = document.getElementById('attackConfirmModal');
    var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();
}

function confirmAttack() {
    var modalEl = document.getElementById('attackConfirmModal');
    var modal = bootstrap.Modal.getInstance(modalEl);
    if (modal) modal.hide();

    var form = document.getElementById('attackForm');

    // Fallback path: exactly what happened before this change.
    function fallbackSubmit() { form.submit(); }

    if (!window.fetch) { fallbackSubmit(); return; }

    fetch(form.getAttribute('action'), {
        method: 'POST',
        body: new FormData(form),
        credentials: 'same-origin'
    })
    .then(function (response) {
        return response.text().then(function (html) {
            return { html: html, url: response.url };
        });
    })
    .then(function (result) { handleBoardResponse(result); })
    .catch(function () { fallbackSubmit(); });
}

function handleBoardResponse(result) {
    if (!result.url || result.url.indexOf('/Battleship/AttackBoard') === -1) {
        // The game likely finished or moved to another screen (e.g. GameResult).
        // Do a normal navigation — safest option, matches original behavior.
        window.location.href = result.url || ('/Battleship/AttackBoard?gameId=' + gameId);
        return;
    }
    if (!swapBattleContent(result.html)) {
        // Unexpected response shape — fall back to a full reload rather than
        // leaving the user looking at a stale board.
        window.location.href = '/Battleship/AttackBoard?gameId=' + gameId;
    }
}

function swapBattleContent(html) {
    try {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var newContent = doc.getElementById('battleContent');
        var oldContent = document.getElementById('battleContent');
        if (!newContent || !oldContent) return false;
        oldContent.replaceWith(newContent);
        restartPollingIfNeeded();
        return true;
    } catch (e) {
        return false;
    }
}

function restartPollingIfNeeded() {
    if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
    var el = document.getElementById('battleContent');
    if (!el) return;
    var myTurn = el.getAttribute('data-my-turn') === '1';
    var finished = el.getAttribute('data-finished') === '1';
    if (!myTurn && !finished) {
        pollInterval = setInterval(pollBoard, 6000);
    }
}

function pollBoard() {
    if (!window.fetch) {
        window.location.href = '/Battleship/AttackBoard?gameId=' + gameId;
        return;
    }
    fetch('/Battleship/AttackBoard?gameId=' + gameId, { credentials: 'same-origin' })
        .then(function (response) {
            return response.text().then(function (html) {
                return { html: html, url: response.url };
            });
        })
        .then(function (result) { handleBoardResponse(result); })
        .catch(function () {
            // Defensive fallback: same full-reload behavior as before this change.
            window.location.href = '/Battleship/AttackBoard?gameId=' + gameId;
        });
}

document.addEventListener('DOMContentLoaded', restartPollingIfNeeded);
</script>
}
