@{ ViewData["Title"] = "Rendirse"; }
<div class="row justify-content-center"><div class="col-md-5">
    <div class="card shadow border-0 rounded-4"><div class="card-body p-5 text-center">
        <i class="fas fa-flag fa-3x text-danger mb-3"></i>
        <h5 class="fw-bold">¿Estás seguro que deseas rendirte?</h5>
        <p class="text-muted">Si te rindes, el otro jugador será declarado ganador.</p>
        <div class="d-flex gap-2 justify-content-center mt-4">
            <form asp-action="Surrender" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="gameId" value="@ViewBag.GameId" />
                <button type="submit" class="btn btn-danger"><i class="fas fa-flag me-2"></i>Sí, rendirme</button>
            </form>
            <a asp-action="AttackBoard" asp-route-gameId="@ViewBag.GameId" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </div></div>
</div></div>
