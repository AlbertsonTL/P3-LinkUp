@model LinkUp.Web.Models.BattleshipIndexViewModel
@{ ViewData["Title"] = "Battleship"; }

<h4 class="fw-bold mb-4"><i class="fas fa-ship me-2 text-primary"></i>Battleship</h4>

<!-- Active Games -->
<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-primary text-white rounded-top-4 d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="fas fa-gamepad me-2"></i>Partidas activas</h6>
        <a asp-action="NewGame" class="btn btn-sm btn-light"><i class="fas fa-plus me-1"></i>Nueva partida</a>
    </div>
    <div class="card-body p-0">
        @foreach (var game in Model.ActiveGames)
        {
            var opponent = game.Player1Id == Model.CurrentUserId ? game.Player2UserName : game.Player1UserName;
            <div class="p-3 border-bottom d-flex align-items-center">
                <div class="flex-grow-1">
                    <span class="fw-semibold">vs @opponent</span>
                    <small class="text-muted d-block">
                        Iniciada: @game.CreatedAt.ToString("dd/MM/yyyy HH:mm") · @Math.Round(game.HoursElapsed, 1) horas
                    </small>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="EnterGame" asp-route-gameId="@game.Id" class="btn btn-sm btn-success">
                        <i class="fas fa-play me-1"></i>Entrar
                    </a>
                    <a asp-action="ConfirmSurrender" asp-route-gameId="@game.Id" class="btn btn-sm btn-outline-danger">
                        <i class="fas fa-flag me-1"></i>Rendirse
                    </a>
                </div>
            </div>
        }
        @if (!Model.ActiveGames.Any())
        {
            <p class="text-center text-muted py-4">No tienes partidas activas.</p>
        }
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-info text-white border-0 rounded-4 text-center p-3">
            <h3 class="fw-bold">@Model.TotalGames</h3>
            <p class="mb-0 small">Partidas jugadas</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white border-0 rounded-4 text-center p-3">
            <h3 class="fw-bold">@Model.GamesWon</h3>
            <p class="mb-0 small">Victorias</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-danger text-white border-0 rounded-4 text-center p-3">
            <h3 class="fw-bold">@Model.GamesLost</h3>
            <p class="mb-0 small">Derrotas</p>
        </div>
    </div>
</div>

<!-- History -->
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-secondary text-white rounded-top-4">
        <h6 class="mb-0"><i class="fas fa-history me-2"></i>Historial de partidas</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Oponente</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Duración</th>
                        <th>Resultado</th>
                        <th>Ganador</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in Model.FinishedGames)
                    {
                        var opponent = game.Player1Id == Model.CurrentUserId ? game.Player2UserName : game.Player1UserName;
                        var won = game.WinnerId == Model.CurrentUserId;
                        var winnerName = game.WinnerId == Model.CurrentUserId ? "Yo" : (game.WinnerUserName ?? "?");
                        <tr>
                            <td>@opponent</td>
                            <td>@game.CreatedAt.ToString("dd/MM/yy")</td>
                            <td>@(game.FinishedAt?.ToString("dd/MM/yy") ?? "-")</td>
                            <td>@Math.Round(game.HoursElapsed, 1)h</td>
                            <td>
                                <span class="badge @(won ? "bg-success" : "bg-danger")">
                                    @(won ? "Victoria" : "Derrota")
                                </span>
                            </td>
                            <td>@winnerName</td>
                            <td>
                                <a asp-action="GameResult" asp-route-gameId="@game.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye me-1"></i>Ver resultado
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.FinishedGames.Any())
        {
            <p class="text-center text-muted py-4">No tienes partidas finalizadas.</p>
        }
    </div>
</div>
