@using System.Collections.Generic
@model List<int[]>
@{
    ViewData["Title"] = "Mis barcos";
    var placedSet = new HashSet<string>((Model ?? new List<int[]>()).Select(c => $"{c[0]},{c[1]}"));
    int gameId = (int)(ViewBag.GameId ?? 0);
    bool isResult = (bool)(ViewBag.IsResult ?? false);
}

<div class="row justify-content-center">
    <div class="col-auto">
        <div class="d-flex align-items-center mb-3">
            @if (isResult)
            {
                <a asp-action="GameResult" asp-route-gameId="@gameId" class="btn-icon me-3" aria-label="Volver a resultados">
                    <i class="fas fa-arrow-left"></i>
                </a>
            }
            else
            {
                <a asp-action="AttackBoard" asp-route-gameId="@gameId" class="btn-icon me-3" aria-label="Volver al tablero de ataque">
                    <i class="fas fa-arrow-left"></i>
                </a>
            }
            <h4 class="fw-800 text-navy mb-0"><i class="fas fa-ship me-2 text-gold"></i>Mi tablero de posicionamiento</h4>
        </div>
        <p class="d-md-none text-center text-muted small mb-2"><i class="fas fa-arrows-alt-h me-1"></i>Desliza para ver todo el tablero</p>
        <div class="table-responsive">
            <table class="battleship-board">
                @for (int row = 0; row < 12; row++)
                {
                    <tr>
                        @for (int col = 0; col < 12; col++)
                        {
                            var occupied = placedSet.Contains($"{row},{col}");
                            <td class="@(occupied ? "occupied" : "")" style="cursor:default">
                                @if (occupied) { <text>⚓</text> }
                            </td>
                        }
                    </tr>
                }
            </table>
        </div>
    </div>
</div>
