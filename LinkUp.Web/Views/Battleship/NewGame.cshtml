@model LinkUp.Web.Models.SelectFriendForGameViewModel
@{ ViewData["Title"] = "Nueva partida"; }

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card post-card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <a asp-action="Index" class="btn-icon me-3" aria-label="Volver a Battleship">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <h4 class="fw-800 mb-0"><i class="fas fa-ship me-2 text-gold"></i>Selecciona un amigo</h4>
                </div>

                <form asp-action="NewGame" method="get" class="mb-3">
                    <div class="input-group">
                        <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Buscar amigo..." />
                        <button type="submit" class="btn btn-outline-primary"><i class="fas fa-search"></i></button>
                    </div>
                </form>

                <form asp-action="CreateGame" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4" style="max-height:400px;overflow-y:auto;">
                        @foreach (var friend in Model.Friends)
                        {
                            <label class="friend-item" style="cursor:pointer">
                                <input type="radio" name="friendId" value="@friend.Id" class="form-check-input me-1" required />
                                @if (friend.ProfilePicture != null)
                                {
                                    <img src="@friend.ProfilePicture" class="avatar" alt="@friend.UserName" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder" style="width:42px;height:42px">
                                        @friend.UserName.First().ToString().ToUpper()
                                    </div>
                                }
                                <span class="friend-username">@friend.UserName</span>
                            </label>
                        }
                    </div>
                    @if (!Model.Friends.Any())
                    {
                        <div class="empty-state">
                            <i class="fas fa-user-friends"></i>
                            <p class="mb-0">No hay amigos disponibles para jugar.</p>
                        </div>
                    }
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-gold" @(Model.Friends.Any() ? "" : "disabled")>
                            <i class="fas fa-play me-2"></i>Iniciar partida
                        </button>
                        <a asp-action="Index" class="btn btn-ghost"><i class="fas fa-arrow-left me-2"></i>Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
