@using LinkUp.Application.DTOs.Response
@model List<AttackCellDto>
@{
    ViewData["Title"] = "Tablero del oponente";
    var attacks = Model ?? new List<AttackCellDto>();
    var attackMap = attacks.ToDictionary(c => $"{c.Row},{c.Col}", c => c.IsHit);
    int gameId = (int)(ViewBag.GameId ?? 0);
}

<div class="row justify-content-center">
    <div class="col-auto">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="GameResult" asp-route-gameId="@gameId" class="btn-icon me-3" aria-label="Volver a resultados">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h4 class="fw-800 text-navy mb-0">Tablero de ataque de @ViewBag.OpponentName</h4>
        </div>
        <div class="d-flex gap-3 mb-3 small">
            <span><span class="badge" style="background:rgba(220,53,69,.2);color:#DC3545;border:1px solid #DC3545">💥 Acertado</span></span>
            <span><span class="badge" style="background:rgba(26,138,74,.15);color:#1A8A4A;border:1px solid #1A8A4A">💧 Fallado</span></span>
            <span class="badge bg-light text-muted border">Sin atacar</span>
        </div>
        <p class="d-md-none text-center text-muted small mb-2"><i class="fas fa-arrows-alt-h me-1"></i>Desliza para ver todo el tablero</p>
        <div class="table-responsive">
            <table class="battleship-board">
                @for (int row = 0; row < 12; row++)
                {
                    <tr>
                        @for (int col = 0; col < 12; col++)
                        {
                            var key = $"{row},{col}";
                            var wasAttacked = attackMap.ContainsKey(key);
                            var isHit = wasAttacked && attackMap[key];
                            var cellClass = wasAttacked ? (isHit ? "hit" : "miss") : "";
                            <td class="@cellClass" style="cursor:default">
                                @if (isHit) { <text>💥</text> }
                                else if (wasAttacked) { <text>💧</text> }
                            </td>
                        }
                    </tr>
                }
            </table>
        </div>
        <a asp-action="GameResult" asp-route-gameId="@gameId" class="btn btn-outline-secondary mt-3">
            <i class="fas fa-arrow-left me-2"></i>Volver a resultados
        </a>
    </div>
</div>
