@using LinkUp.Application.DTOs.Response
@model List<AttackCellDto>
@{
    ViewData["Title"] = "Tablero del oponente";
    var attacks = Model ?? new List<AttackCellDto>();
    var attackMap = attacks.ToDictionary(c => $"{c.Row},{c.Col}", c => c.IsHit);
    int gameId = (int)(ViewBag.GameId ?? 0);
}

<div class="row justify-content-center">
    <div class="col-auto">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="GameResult" asp-route-gameId="@gameId" class="btn btn-outline-secondary btn-sm me-3">
                <i class="fas fa-arrow-left"></i>
            </a>
            <h4 class="fw-bold mb-0">Tablero de ataque de @ViewBag.OpponentName</h4>
        </div>
        <div class="mb-3">
            <span class="badge bg-danger me-2">💥 Acertado</span>
            <span class="badge bg-success me-2">💧 Fallado</span>
            <span class="badge bg-light text-dark border">Sin atacar</span>
        </div>
        <table class="table table-bordered" style="border-collapse:collapse">
            @for (int row = 0; row < 12; row++)
            {
                <tr>
                    @for (int col = 0; col < 12; col++)
                    {
                        var key = $"{row},{col}";
                        var wasAttacked = attackMap.ContainsKey(key);
                        var isHit = wasAttacked && attackMap[key];
                        var bg = wasAttacked ? (isHit ? "bg-danger" : "bg-success") : "";
                        <td class="p-0 text-center @bg" style="width:38px;height:38px">
                            @if (isHit) { <span>💥</span> }
                            else if (wasAttacked) { <span>💧</span> }
                        </td>
                    }
                </tr>
            }
        </table>
        <a asp-action="GameResult" asp-route-gameId="@gameId" class="btn btn-outline-secondary mt-3">
            <i class="fas fa-arrow-left me-2"></i>Volver a resultados
        </a>
    </div>
</div>
