@model LinkUp.Web.Models.SelectShipViewModel
@{ ViewData["Title"] = "Seleccionar barco"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="page-header">
            <h4><i class="fas fa-ship text-gold"></i>Posiciona tus barcos</h4>
        </div>

        <div class="card border-0 shadow-sm rounded-xl mb-4">
            <div class="card-body p-4">
                <p class="text-muted mb-4">
                    Selecciona uno de los barcos restantes y haz clic en <strong>Posicionar barco</strong>
                    para elegir su ubicación en el tablero.
                </p>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
                }

                <form asp-action="SelectShipPost" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GameId" value="@Model.GameId" />

                    <div class="mb-4">
                        @foreach (var ship in Model.RemainingShips)
                        {
                            <label class="ship-option" id="ship-opt-@ship.Size-@Model.RemainingShips.ToList().IndexOf(ship)">
                                <input type="radio" name="SelectedShipSize" value="@ship.Size"
                                       class="d-none"
                                       onchange="selectShip(this, 'ship-opt-@ship.Size-@Model.RemainingShips.ToList().IndexOf(ship)')" />
                                <div class="d-flex align-items-center gap-3 w-100">
                                    <div>
                                        <div class="fw-bold text-navy">@ship.Name</div>
                                        <div class="mt-1">
                                            @for (int i = 0; i < ship.Size; i++)
                                            {
                                                <span style="font-size:1.3rem">🚢</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="ms-auto">
                                        <span class="status-badge status-pending">@ship.Size celdas</span>
                                    </div>
                                </div>
                            </label>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-gold">
                            <i class="fas fa-map-marker-alt me-2"></i>Posicionar barco
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function selectShip(radio, optId) {
    document.querySelectorAll('.ship-option').forEach(el => el.classList.remove('selected-ship'));
    document.getElementById(optId).classList.add('selected-ship');
}
</script>
}
