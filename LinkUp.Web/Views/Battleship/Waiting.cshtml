@model LinkUp.Web.Models.WaitingBoardViewModel
@{
    ViewData["Title"] = "Esperando al oponente";
    var placedSet = new HashSet<string>(Model.PlacedCells.Select(c => $"{c[0]},{c[1]}"));
}

<div class="row justify-content-center">
    <div class="col-auto">
        <div class="turn-banner wait-turn mb-4">
            <i class="fas fa-hourglass-half fa-lg"></i>
            <span>El otro jugador aún no ha terminado de posicionar sus barcos</span>
        </div>

        <p class="text-muted text-center small mb-4">
            Esta página se actualiza automáticamente cada 5 segundos.
            Cuando el oponente termine, serás redirigido al tablero de ataque.
        </p>

        <h5 class="fw-bold mb-3 text-navy">
            <i class="fas fa-ship me-2 text-gold"></i>Tu posicionamiento actual:
        </h5>

        <p class="d-md-none text-center text-muted small mb-2"><i class="fas fa-arrows-alt-h me-1"></i>Desliza para ver todo el tablero</p>
        <div class="table-responsive">
            <table class="battleship-board">
                @for (int row = 0; row < 12; row++)
                {
                    <tr>
                        @for (int col = 0; col < 12; col++)
                        {
                            var occupied = placedSet.Contains($"{row},{col}");
                            <td class="@(occupied ? "occupied" : "")" style="cursor:default">
                                @if (occupied) { <text>⚓</text> }
                            </td>
                        }
                    </tr>
                }
            </table>
        </div>

        <div class="d-flex gap-2 mt-4">
            <a asp-action="Waiting" asp-route-gameId="@Model.GameId" class="btn btn-primary">
                <i class="fas fa-sync me-2"></i>Refrescar ahora
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver al inicio
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
// ---------------------------------------------------------------
// No se creó ningún endpoint nuevo: se sigue consultando exactamente
// /Battleship/EnterGame?gameId=... (la misma URL que antes). La única
// diferencia es que ahora, si el oponente TODAVÍA no está listo, no se
// recarga la página completa — solo se vuelve a preguntar en 5s.
// Si algo falla, se recurre al comportamiento original (navegación completa).
// ---------------------------------------------------------------
var gameId = @Model.GameId;
var enterGameUrl = '/Battleship/EnterGame?gameId=' + gameId;

function checkOpponentReady() {
    if (!window.fetch) {
        window.location.href = enterGameUrl;
        return;
    }
    fetch(enterGameUrl, { credentials: 'same-origin' })
        .then(function (response) {
            if (response.url && response.url.indexOf('/Battleship/Waiting') === -1) {
                // State changed (opponent ready, or game finished by surrender) — navigate for real.
                window.location.href = response.url;
            } else {
                setTimeout(checkOpponentReady, 5000);
            }
        })
        .catch(function () {
            // Defensive fallback: same behavior as before this change.
            window.location.href = enterGameUrl;
        });
}

setTimeout(checkOpponentReady, 5000);
</script>
}
