@model LinkUp.Web.Models.NewFriendRequestViewModel
@{ ViewData["Title"] = "Nueva solicitud de amistad"; }

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card post-card">
            <div class="card-body">
                <div class="d-flex align-items-center mb-4">
                    <a asp-action="Index" class="btn-icon me-3" aria-label="Volver a solicitudes">
                        <i class="fas fa-arrow-left"></i>
                    </a>
                    <h4 class="fw-800 mb-0">
                        <i class="fas fa-user-plus me-2 text-gold"></i>Nueva solicitud de amistad
                    </h4>
                </div>

                <!-- Búsqueda -->
                <form asp-action="NewRequest" method="get" class="mb-4">
                    <div class="input-group">
                        <input type="text" name="search" value="@Model.Search" class="form-control"
                               placeholder="Buscar por nombre de usuario..." />
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="fas fa-search me-1"></i>Buscar
                        </button>
                    </div>
                </form>

                <form asp-action="Send" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger d-none"></div>

                    <div class="mb-4" style="max-height:400px;overflow-y:auto;">
                        @foreach (var user in Model.AvailableUsers)
                        {
                            <label class="friend-item" style="cursor:pointer">
                                <input type="radio" name="SelectedUserId" value="@user.Id" class="form-check-input me-1" />
                                @if (user.ProfilePicture != null)
                                {
                                    <img src="@user.ProfilePicture" class="avatar" alt="@user.UserName" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder" style="width:42px;height:42px">
                                        @user.UserName.First().ToString().ToUpper()
                                    </div>
                                }
                                <div>
                                    <span class="friend-username d-block">@user.UserName</span>
                                    <span class="friend-meta">@user.CommonFriendsCount amigos en común</span>
                                </div>
                            </label>
                        }
                    </div>

                    @if (!Model.AvailableUsers.Any())
                    {
                        <div class="empty-state">
                            <i class="fas fa-search"></i>
                            @if (!string.IsNullOrEmpty(Model.Search))
                            {
                                <span>No se encontraron usuarios con "@Model.Search"</span>
                            }
                            else
                            {
                                <span>No hay usuarios disponibles para enviar solicitudes.</span>
                            }
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary" @(Model.AvailableUsers.Any() ? "" : "disabled")>
                            <i class="fas fa-paper-plane me-2"></i>Enviar solicitud
                        </button>
                        <a asp-action="Index" class="btn btn-ghost">
                            <i class="fas fa-arrow-left me-2"></i>Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
