@model LinkUp.Web.Models.ConfirmRemoveFriendViewModel
@{ ViewData["Title"] = "Eliminar amigo"; }

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-5 text-center">
                <i class="fas fa-user-minus fa-3x text-danger mb-3"></i>
                <h4 class="fw-bold mb-3">¿Eliminar amigo?</h4>

                <div class="d-flex align-items-center justify-content-center mb-4">
                    @if (Model.FriendProfilePicture != null)
                    {
                        <img src="@Model.FriendProfilePicture" class="rounded-circle me-2 border"
                             style="width:48px;height:48px;object-fit:cover" alt="@Model.FriendUserName" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2"
                             style="width:48px;height:48px">
                            @Model.FriendUserName.First().ToString().ToUpper()
                        </div>
                    }
                    <span class="fw-semibold">@Model.FriendUserName</span>
                </div>

                <p class="text-muted mb-4">
                    ¿Está seguro que desea eliminar a <strong>@Model.FriendUserName</strong> de su lista de amigos?
                    Sus publicaciones ya no aparecerán en su feed.
                </p>

                <form asp-action="Remove" method="post" class="d-flex gap-3 justify-content-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="friendId" value="@Model.FriendId" />
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-check me-2"></i>Sí, eliminar
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
