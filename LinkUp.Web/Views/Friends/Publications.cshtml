@model LinkUp.Web.Models.FriendPublicationsViewModel
@{
    ViewData["Title"] = $"Publicaciones de {Model.FriendUserName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card post-card mb-4">
            <div class="card-body d-flex align-items-center gap-3">
                @if (Model.FriendProfilePicture != null)
                {
                    <img src="@Model.FriendProfilePicture" class="avatar avatar-lg" alt="@Model.FriendUserName" />
                }
                else
                {
                    <div class="avatar-placeholder avatar-lg" style="font-size:1.3rem">
                        @Model.FriendUserName.First().ToString().ToUpper()
                    </div>
                }
                <div>
                    <h5 class="fw-800 mb-0">@Model.FriendUserName</h5>
                    <span class="text-muted small">Publicaciones de este amigo</span>
                </div>
                <a asp-controller="Friends" asp-action="Index" class="btn btn-ghost btn-sm ms-auto">
                    <i class="fas fa-arrow-left me-1"></i>Volver
                </a>
            </div>
        </div>

        @{
            var postViewData = new ViewDataDictionary(ViewData);
            postViewData["CurrentUserId"] = Model.CurrentUserId;
            postViewData["ReturnTo"] = "Friends";
        }

        @if (Model.Posts != null && Model.Posts.Any())
        {
            @foreach (var post in Model.Posts)
            {
                <partial name="~/Views/Shared/_PostCard.cshtml" model="post" view-data="postViewData" />
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-newspaper"></i>
                <p class="mb-0">@Model.FriendUserName aún no tiene publicaciones.</p>
            </div>
        }
    </div>
</div>
