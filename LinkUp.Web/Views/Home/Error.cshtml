@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #dc3545, #6f42c1);">
    <div class="container text-center text-white">
        <i class="fas fa-exclamation-triangle fa-5x mb-4"></i>
        <h1 class="fw-bold">¡Ocurrió un error!</h1>
        <p class="lead">Lo sentimos, algo salió mal. Por favor intenta nuevamente.</p>
        <a asp-controller="Posts" asp-action="Index" class="btn btn-light btn-lg mt-3">
            <i class="fas fa-home me-2"></i>Volver al inicio
        </a>
    </div>
</div>
