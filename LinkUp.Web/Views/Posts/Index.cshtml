@model LinkUp.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Mis publicaciones";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="page-header">
            <h4><i class="fas fa-newspaper"></i>Mis publicaciones</h4>
        </div>

        @if (TempData["Success"] != null)
        {
            <span class="visually-hidden" data-lu-toast="success">@TempData["Success"]</span>
        }
        @if (TempData["Error"] != null)
        {
            <span class="visually-hidden" data-lu-toast="danger">@TempData["Error"]</span>
        }

        <!-- Create Post Form -->
        <div class="card post-card mb-4">
            <div class="card-body">
                <h6 class="fw-800 mb-3 text-navy"><i class="fas fa-plus-circle me-2 text-gold"></i>¿Qué estás pensando?</h6>
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <textarea name="Content" class="form-control" rows="3" placeholder="Comparte algo con tus amigos..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo de contenido</label>
                        <select name="MediaType" class="form-select" id="mediaTypeSelect" onchange="toggleMediaInput()">
                            <option value="image">Imagen</option>
                            <option value="video">Video de YouTube</option>
                        </select>
                    </div>
                    <div id="imageInput" class="mb-3">
                        <label class="form-label">Imagen</label>
                        <input type="file" name="ImageFile" class="form-control" accept="image/*" />
                    </div>
                    <div id="videoInput" class="mb-3" style="display:none">
                        <label class="form-label">Enlace de YouTube</label>
                        <input type="text" name="YouTubeUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane me-2"></i>Publicar
                    </button>
                </form>
            </div>
        </div>

        <!-- Posts List -->
        @{
            var postViewData = new ViewDataDictionary(ViewData);
            postViewData["CurrentUserId"] = Model.CurrentUserId;
            postViewData["ReturnTo"] = "Index";
        }
        @foreach (var post in Model.Posts)
        {
            <partial name="~/Views/Shared/_PostCard.cshtml" model="post" view-data="postViewData" />
        }

        @if (!Model.Posts.Any())
        {
            <div class="empty-state">
                <i class="fas fa-newspaper"></i>
                <p class="fw-600">Aún no tienes publicaciones.</p>
                <p class="mb-0">Usa el cuadro de arriba para compartir tu primer momento con tus amigos.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
function toggleMediaInput() {
    const type = document.getElementById('mediaTypeSelect').value;
    document.getElementById('imageInput').style.display = type === 'image' ? 'block' : 'none';
    document.getElementById('videoInput').style.display = type === 'video' ? 'block' : 'none';
}
function toggleReplyForm(commentId) {
    const form = document.getElementById('reply-form-' + commentId);
    if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
}
</script>
}
