@model LinkUp.Application.DTOs.Response.PostResponseDto
@{
    // Lee desde ViewData (pasado explicitamente), con fallback a 0
    var currentUserId = (ViewData["CurrentUserId"] as int?) ?? 0;
    var returnTo = (ViewData["ReturnTo"] as string) ?? "Index";
    string GetYouTubeEmbed(string url)
    {
        var videoId = "";
        if (url.Contains("v=")) videoId = url.Split("v=")[1].Split("&")[0];
        else if (url.Contains("youtu.be/")) videoId = url.Split("youtu.be/")[1].Split("?")[0];
        return $"https://www.youtube.com/embed/{videoId}";
    }
}

<div class="card post-card mb-4 fade-in-up">
    <div class="card-body">
        <div class="d-flex align-items-center mb-3">
            @if (Model.UserProfilePicture != null)
            {
                <img src="@Model.UserProfilePicture" class="avatar me-2" alt="@Model.UserName" />
            }
            else
            {
                <div class="avatar-placeholder me-2" style="width:42px;height:42px">
                    @Model.UserName.First().ToString().ToUpper()
                </div>
            }
            <div>
                <a href="/Friends/Publications/@Model.UserId" class="post-author-name text-decoration-none d-block">@Model.UserName</a>
                <span class="post-timestamp">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            @if (Model.UserId == currentUserId)
            {
                <div class="ms-auto d-flex gap-2">
                    <a asp-controller="Posts" asp-action="Edit" asp-route-id="@Model.Id" class="btn-icon btn-icon-sm" aria-label="Editar publicación">
                        <i class="fas fa-edit"></i>
                    </a>
                    <form asp-controller="Posts" asp-action="Delete" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn-icon btn-icon-sm btn-icon-danger" aria-label="Eliminar publicación"
                                onclick="return confirm('¿Eliminar publicación?')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </form>
                </div>
            }
        </div>

        <p class="mb-3">@Model.Content</p>

        @if (Model.MediaType == LinkUp.Domain.Enums.PostMediaType.Image && Model.ImagePath != null)
        {
            <img src="@Model.ImagePath" class="img-fluid rounded-xl mb-3" style="max-height:400px;width:100%;object-fit:cover" alt="Imagen de la publicación" />
        }
        @if (Model.MediaType == LinkUp.Domain.Enums.PostMediaType.Video && Model.YouTubeUrl != null)
        {
            <div class="ratio ratio-16x9 mb-3 yt-embed">
                <iframe src="@GetYouTubeEmbed(Model.YouTubeUrl)" allowfullscreen title="Video de la publicación"></iframe>
            </div>
        }

        <div class="d-flex gap-2 mb-3 pb-3 border-bottom">
            @if (Model.CurrentUserReaction == null || Model.CurrentUserReaction == LinkUp.Domain.Enums.ReactionType.Dislike)
            {
                <form asp-controller="Posts" asp-action="React" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="postId" value="@Model.Id" />
                    <input type="hidden" name="isLike" value="true" />
                    <input type="hidden" name="returnTo" value="@returnTo" />
                    <button type="submit" class="btn reaction-btn reaction-like">
                        <i class="fas fa-thumbs-up"></i>Me gusta (@Model.LikeCount)
                    </button>
                </form>
            }
            else
            {
                <span class="btn reaction-btn reaction-like active"><i class="fas fa-thumbs-up"></i>Me gusta (@Model.LikeCount)</span>
            }

            @if (Model.CurrentUserReaction == null || Model.CurrentUserReaction == LinkUp.Domain.Enums.ReactionType.Like)
            {
                <form asp-controller="Posts" asp-action="React" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="postId" value="@Model.Id" />
                    <input type="hidden" name="isLike" value="false" />
                    <input type="hidden" name="returnTo" value="@returnTo" />
                    <button type="submit" class="btn reaction-btn reaction-dislike">
                        <i class="fas fa-thumbs-down"></i>No me gusta (@Model.DislikeCount)
                    </button>
                </form>
            }
            else
            {
                <span class="btn reaction-btn reaction-dislike active"><i class="fas fa-thumbs-down"></i>No me gusta (@Model.DislikeCount)</span>
            }
        </div>

        <!-- Comments -->
        <div class="comments-section">
            @{
                var commentViewData = new ViewDataDictionary(ViewData);
                commentViewData["PostId"] = Model.Id;
                commentViewData["CurrentUserId"] = currentUserId;
                commentViewData["ReturnTo"] = returnTo;
                var topLevelComments = Model.Comments.Where(c => c.ParentCommentId == null).ToList();
            }
            @if (topLevelComments.Any())
            {
                <div class="section-divider">Comentarios</div>
                @foreach (var comment in topLevelComments)
                {
                    <partial name="_CommentItem" model="comment" view-data="commentViewData" />
                }
            }
        </div>

        <!-- Add Comment Form -->
        <form asp-controller="Posts" asp-action="AddComment" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="PostId" value="@Model.Id" />
            <input type="hidden" name="returnTo" value="@returnTo" />
            <div class="input-group">
                <input type="text" name="Content" class="form-control" placeholder="Agrega un comentario..." required />
                <button type="submit" class="btn btn-primary" aria-label="Enviar comentario"><i class="fas fa-paper-plane"></i></button>
            </div>
        </form>
    </div>
</div>
